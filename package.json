{
  "name": "paseo-tui",
  "version": "0.1.0",
  "description": "Ghostty-first terminal TUI for a single Paseo agent session",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "paseo-tui": "./dist/main.js",
    "pt": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "paseo",
    "tui",
    "ghostty",
    "terminal"
  ],
  "author": "huanghaiyangyy",
  "license": "MIT",
  "dependencies": {
    "@earendil-works/pi-tui": "0.85.0",
    "@getpaseo/client": "0.7.2"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "tsx": "4.23.13",
    "typescript": "5.9.2"
  }
}
